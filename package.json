{
  "name": "revisto",
  "version": "1.0.0",
  "private": true,
  "description": "Centralized feedback widget server and admin panel.",
  "engines": {
    "node": ">=20 <=22"
  },
  "scripts": {
    "dev": "next dev",
    "build:widget": "node scripts/build-widget.mjs",
    "build": "npm run build:widget && next build",
    "start": "node server.js",
    "lint": "next lint",
    "hash": "node scripts/hash-password.mjs",
