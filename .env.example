# --- Admin credentials (single admin) ---
# Username you log into the panel with.
ADMIN_USER=admin
# bcrypt-free hash generated by `npm run hash -- "your-password"`.
ADMIN_PASSWORD_HASH=

# --- Security ---
# Long random string used to sign the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Public URL of this server (no trailing slash) ---
# Used inside the served widget script to know where to send feedback.
PUBLIC_BASE_URL=https://feedback.example.com

# --- Storage paths (absolute or relative to project root) ---
# SQLite database file and uploaded attachment directory. Keep on persistent disk.
DB_PATH=./data/feedback.db
UPLOAD_DIR=./data/uploads

# --- Behavior ---
# When 1, brand-new sites are auto-approved on first register.
# When 0 (recommended), new sites arrive as "pending" and you approve them in the panel.
AUTO_APPROVE_SITES=0
