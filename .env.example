# --- Admin credentials (single admin) ---
# Username you log into the panel with.
ADMIN_USER=admin
# bcrypt-free hash generated by `npm run hash -- "your-password"`.
ADMIN_PASSWORD_HASH=

# --- Security ---
# Long random string used to sign the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Public URL of this server (no trailing slash) ---
# Used inside the served widget script to know where to send feedback.
PUBLIC_BASE_URL=https://feedback.example.com

# --- MySQL database (Hostinger-compatible) ---
# Create a MySQL database in the Hostinger panel and fill these in.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=revisto

# --- Storage paths (absolute or relative to project root) ---
# Local fallback directory for attachments. Used only when R2 is NOT configured.
UPLOAD_DIR=./data/uploads

# --- Cloudflare R2 (attachment storage) ---
# When all four are set, attachments are stored in R2 instead of local disk.
# Objects stay private; they are streamed to admins through /api/admin/attachments.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override the S3 API endpoint (defaults to https://<account_id>.r2.cloudflarestorage.com).
R2_ENDPOINT=

# --- Behavior ---
# When 1, brand-new sites are auto-approved on first register.
# When 0 (recommended), new sites arrive as "pending" and you approve them in the panel.
AUTO_APPROVE_SITES=0
